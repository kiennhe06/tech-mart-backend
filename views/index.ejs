<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <div class="background-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>

    <main class="glass-container">
      <header class="header">
        <div class="logo">
          <span class="logo-icon">🚀</span>
          <h1><%= title %></h1>
        </div>
        <p class="subtitle">
          Trạng thái: <span class="status-online">Online</span>
        </p>
      </header>

      <%
        let totalRevenue = 0; // Doanh thu thực tế (Trạng thái 3 - Hoàn tất)
        let pendingRevenue = 0; // Doanh thu đang xử lý (Trạng thái 0, 1, 2)
        let cancelledRevenue = 0; // Doanh thu đã hủy (Trạng thái -1)
        
        let orderCOD = 0;
        let orderBank = 0;
        let orderCard = 0;
        
        let countCompleted = 0;
        let countPending = 0;
        let countProcessing = 0;
        let countShipping = 0;
        let countCancelled = 0;

        orders.forEach(function(o) {
          let cleanStr = o.total.replace(/[^\d]/g, '');
          let amt = parseInt(cleanStr, 10) || 0;
          
          if (o.status == 3) {
            totalRevenue += amt;
            countCompleted++;
          } else if (o.status == -1) {
            cancelledRevenue += amt;
            countCancelled++;
          } else {
            pendingRevenue += amt;
            if (o.status == 0) countPending++;
            if (o.status == 1) countProcessing++;
            if (o.status == 2) countShipping++;
          }

          // Thống kê theo PTTT
          if (o.paymentMethod && o.paymentMethod.includes("Chuyển khoản")) {
            orderBank += amt;
          } else if (o.paymentMethod && o.paymentMethod.includes("Thẻ tín dụng")) {
            orderCard += amt;
          } else {
            orderCOD += amt;
          }
        });

        // Định dạng tiền tệ VND
        function formatVND(num) {
          return num.toLocaleString('vi-VN') + 'đ';
        }
      %>

      <div class="content">
        <!-- Tab Navigation -->
        <div class="tabs-nav">
          <button class="tab-btn active" onclick="switchTab('dashboard')">📊 Thống kê Doanh thu</button>
          <button class="tab-btn" onclick="switchTab('products')">📦 Quản lý Sản phẩm</button>
          <button class="tab-btn" onclick="switchTab('orders')">🧾 Quản lý Đơn hàng</button>
          <button class="tab-btn" onclick="switchTab('users')">👥 Quản lý Người dùng</button>
        </div>

        <!-- Tab Thống kê -->
        <div id="dashboard-tab" class="tab-pane active">
          
          <style>
            .filter-btn {
              background: rgba(255, 255, 255, 0.05);
              border: 1px solid rgba(255, 255, 255, 0.1);
              color: #cbd5e1;
              padding: 8px 16px;
              border-radius: 10px;
              font-size: 13px;
              font-weight: 600;
              cursor: pointer;
              transition: all 0.3s ease;
            }
            .filter-btn:hover {
              background: rgba(255, 255, 255, 0.1);
              color: #fff;
            }
            .filter-btn.active {
              background: linear-gradient(135deg, #6366f1, #a855f7);
              border-color: transparent;
              color: #fff;
              box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
            }
            .date-input {
              background: rgba(255, 255, 255, 0.05);
              border: 1px solid rgba(255, 255, 255, 0.1);
              color: #fff;
              padding: 8px 12px;
              border-radius: 10px;
              font-size: 13px;
              outline: none;
              transition: all 0.3s ease;
            }
            .date-input:focus {
              border-color: #6366f1;
              background: rgba(255, 255, 255, 0.08);
            }
          </style>

          <!-- Date Filter Bar -->
          <div class="card" style="padding: 16px 24px; margin-bottom: 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; backdrop-filter: blur(10px);">
            <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
              <span style="font-size: 13px; color: #cbd5e1; font-weight: 600; margin-right: 8px;">📅 LỌC THEO THỜI GIAN:</span>
              <button class="filter-btn active" onclick="setDateFilter('all')">Tất cả</button>
              <button class="filter-btn" onclick="setDateFilter('today')">Hôm nay</button>
              <button class="filter-btn" onclick="setDateFilter('yesterday')">Hôm qua</button>
              <button class="filter-btn" onclick="setDateFilter('7days')">7 ngày qua</button>
              <button class="filter-btn" onclick="setDateFilter('month')">Tháng này</button>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
              <span style="font-size: 13px; color: #cbd5e1; font-weight: 500;">Từ ngày:</span>
              <input type="date" id="filter-start-date" class="date-input" onchange="setDateFilter('custom')">
              <span style="color: rgba(255,255,255,0.3);">➔</span>
              <span style="font-size: 13px; color: #cbd5e1; font-weight: 500;">Đến ngày:</span>
              <input type="date" id="filter-end-date" class="date-input" onchange="setDateFilter('custom')">
            </div>
          </div>

          <!-- Stats Grid -->
          <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px;">
            
            <div class="stat-card" style="background: linear-gradient(135deg, rgba(255, 0, 127, 0.15), rgba(127, 0, 255, 0.15)); border: 1px solid rgba(255, 0, 127, 0.3); border-radius: 16px; padding: 24px; position: relative; overflow: hidden; backdrop-filter: blur(10px);">
              <div style="font-size: 13px; color: #cbd5e1; opacity: 0.8; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Doanh thu thực tế (Hoàn tất)</div>
              <div id="stat-revenue-real" style="font-size: 28px; font-weight: 800; color: #ff007f; margin-top: 10px; text-shadow: 0 0 20px rgba(255, 0, 127, 0.3);"><%= formatVND(totalRevenue) %></div>
              <div id="stat-count-completed" style="font-size: 12px; color: #4CAF50; margin-top: 8px; font-weight: 600;">✓ <%= countCompleted %> đơn hàng thành công</div>
            </div>

            <div class="stat-card" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 24px; backdrop-filter: blur(10px);">
              <div style="font-size: 13px; color: #cbd5e1; opacity: 0.8; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Doanh thu chờ xử lý</div>
              <div id="stat-revenue-pending" style="font-size: 28px; font-weight: 800; color: #ffd700; margin-top: 10px; text-shadow: 0 0 20px rgba(255, 215, 0, 0.2);"><%= formatVND(pendingRevenue) %></div>
              <div id="stat-count-pending-sum" style="font-size: 12px; color: #ffd700; margin-top: 8px; font-weight: 600;">⏳ <%= countPending + countProcessing + countShipping %> đơn đang xử lý</div>
            </div>

            <div class="stat-card" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 24px; backdrop-filter: blur(10px);">
              <div style="font-size: 13px; color: #cbd5e1; opacity: 0.8; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Tổng số Đơn hàng</div>
              <div id="stat-total-orders" style="font-size: 28px; font-weight: 800; color: #6366f1; margin-top: 10px; text-shadow: 0 0 20px rgba(99, 102, 241, 0.2);"><%= orders.length %></div>
              <div id="stat-count-cancelled" style="font-size: 12px; color: #ff4d4d; margin-top: 8px; font-weight: 600;">✗ <%= countCancelled %> đơn đã hủy</div>
            </div>

            <div class="stat-card" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 24px; backdrop-filter: blur(10px);">
              <div style="font-size: 13px; color: #cbd5e1; opacity: 0.8; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Khách hàng đăng ký</div>
              <div style="font-size: 28px; font-weight: 800; color: #00f2fe; margin-top: 10px; text-shadow: 0 0 20px rgba(0, 242, 254, 0.2);"><%= users.length %></div>
              <div style="font-size: 12px; color: #00f2fe; margin-top: 8px; font-weight: 600;">👥 Thành viên TechMart</div>
            </div>

          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 30px;">
            <!-- Cổng Thanh Toán Card -->
            <div class="card" style="padding: 24px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; backdrop-filter: blur(10px);">
              <h3 style="margin-top: 0; margin-bottom: 20px; font-size: 16px; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px; font-weight: 700;">📈 DOANH THU THEO PHƯƠNG THỨC</h3>
              
              <div style="display: flex; flex-direction: column; gap: 16px;">
                <div>
                  <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 6px;">
                    <span style="color: #cbd5e1;">💵 Thanh toán khi nhận hàng (COD)</span>
                    <span id="pay-cod-amount" style="color: #fff; font-weight: 600;"><%= formatVND(orderCOD) %></span>
                  </div>
                  <div style="height: 8px; background: rgba(255,255,255,0.05); border-radius: 4px; overflow: hidden;">
                    <% let codPercent = (orderCOD + orderBank + orderCard) > 0 ? (orderCOD / (orderCOD + orderBank + orderCard)) * 100 : 0; %>
                    <div id="pay-cod-progress" style="height: 100%; width: <%= codPercent %>%; background: #4CAF50; border-radius: 4px; transition: width 0.4s ease;"></div>
                  </div>
                </div>

                <div>
                  <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 6px;">
                    <span style="color: #cbd5e1;">🏦 Chuyển khoản ngân hàng (Techcombank)</span>
                    <span id="pay-bank-amount" style="color: #fff; font-weight: 600;"><%= formatVND(orderBank) %></span>
                  </div>
                  <div style="height: 8px; background: rgba(255,255,255,0.05); border-radius: 4px; overflow: hidden;">
                    <% let bankPercent = (orderCOD + orderBank + orderCard) > 0 ? (orderBank / (orderCOD + orderBank + orderCard)) * 100 : 0; %>
                    <div id="pay-bank-progress" style="height: 100%; width: <%= bankPercent %>%; background: #6366f1; border-radius: 4px; transition: width 0.4s ease;"></div>
                  </div>
                </div>

                <div>
                  <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 6px;">
                    <span style="color: #cbd5e1;">💳 Thẻ tín dụng / Ghi nợ (VISA)</span>
                    <span id="pay-card-amount" style="color: #fff; font-weight: 600;"><%= formatVND(orderCard) %></span>
                  </div>
                  <div style="height: 8px; background: rgba(255,255,255,0.05); border-radius: 4px; overflow: hidden;">
                    <% let cardPercent = (orderCOD + orderBank + orderCard) > 0 ? (orderCard / (orderCOD + orderBank + orderCard)) * 100 : 0; %>
                    <div id="pay-card-progress" style="height: 100%; width: <%= cardPercent %>%; background: #ff007f; border-radius: 4px; transition: width 0.4s ease;"></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Trạng thái đơn hàng Card -->
            <div class="card" style="padding: 24px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; backdrop-filter: blur(10px);">
              <h3 style="margin-top: 0; margin-bottom: 20px; font-size: 16px; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px; font-weight: 700;">📊 PHÂN BỔ TRẠNG THÁI ĐƠN HÀNG</h3>
              
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 12px; text-align: center;">
                  <div style="font-size: 11px; color: #cbd5e1; opacity: 0.6; font-weight: 600; text-transform: uppercase;">Chờ xác nhận</div>
                  <div id="status-count-0" style="font-size: 20px; font-weight: 700; color: #ff9f43; margin-top: 4px;"><%= countPending %></div>
                </div>
                <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 12px; text-align: center;">
                  <div style="font-size: 11px; color: #cbd5e1; opacity: 0.6; font-weight: 600; text-transform: uppercase;">Đang xử lý</div>
                  <div id="status-count-1" style="font-size: 20px; font-weight: 700; color: #7367f0; margin-top: 4px;"><%= countProcessing %></div>
                </div>
                <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 12px; text-align: center;">
                  <div style="font-size: 11px; color: #cbd5e1; opacity: 0.6; font-weight: 600; text-transform: uppercase;">Đang giao hàng</div>
                  <div id="status-count-2" style="font-size: 20px; font-weight: 700; color: #00cfe8; margin-top: 4px;"><%= countShipping %></div>
                </div>
                <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 12px; text-align: center;">
                  <div style="font-size: 11px; color: #cbd5e1; opacity: 0.6; font-weight: 600; text-transform: uppercase;">Hoàn thành</div>
                  <div id="status-count-3" style="font-size: 20px; font-weight: 700; color: #28c76f; margin-top: 4px;"><%= countCompleted %></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <script>
          // Đồng bộ hóa dữ liệu hóa đơn trực tiếp từ MongoDB sang JS phía Client
          const allOrdersData = <%- JSON.stringify(orders) %>;

          function setDateFilter(type) {
            // Cập nhật class active cho nút bấm
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            if (type !== 'custom') {
              const btnMap = {
                'all': 0, 'today': 1, 'yesterday': 2, '7days': 3, 'month': 4
              };
              const targetBtn = document.querySelectorAll('.filter-btn')[btnMap[type]];
              if (targetBtn) targetBtn.classList.add('active');
              
              // Reset date inputs
              document.getElementById('filter-start-date').value = '';
              document.getElementById('filter-end-date').value = '';
            }

            let start = null;
            let end = null;
            const now = new Date();

            if (type === 'today') {
              start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
              end = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59, 999);
            } else if (type === 'yesterday') {
              start = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
              end = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1, 23, 59, 59, 999);
            } else if (type === '7days') {
              start = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
              start.setHours(0,0,0,0);
              end = now;
            } else if (type === 'month') {
              start = new Date(now.getFullYear(), now.getMonth(), 1);
              end = now;
            } else if (type === 'custom') {
              const startVal = document.getElementById('filter-start-date').value;
              const endVal = document.getElementById('filter-end-date').value;
              if (startVal) {
                start = new Date(startVal);
                start.setHours(0, 0, 0, 0);
              }
              if (endVal) {
                end = new Date(endVal);
                end.setHours(23, 59, 59, 999);
              }
            }

            // Tiến hành lọc dữ liệu
            let filtered = allOrdersData;
            if (start || end) {
              filtered = allOrdersData.filter(o => {
                const oDate = new Date(o.orderDate);
                if (start && oDate < start) return false;
                if (end && oDate > end) return false;
                return true;
              });
            }

            // Tính toán lại các chỉ số thống kê
            let totalRevenue = 0;
            let pendingRevenue = 0;
            let cancelledRevenue = 0;
            let orderCOD = 0;
            let orderBank = 0;
            let orderCard = 0;
            let countCompleted = 0;
            let countPending = 0;
            let countProcessing = 0;
            let countShipping = 0;
            let countCancelled = 0;

            filtered.forEach(o => {
              const cleanStr = o.total.replace(/[^\d]/g, '');
              const amt = parseInt(cleanStr, 10) || 0;
              
              if (o.status == 3) {
                totalRevenue += amt;
                countCompleted++;
              } else if (o.status == -1) {
                cancelledRevenue += amt;
                countCancelled++;
              } else {
                pendingRevenue += amt;
                if (o.status == 0) countPending++;
                if (o.status == 1) countProcessing++;
                if (o.status == 2) countShipping++;
              }

              if (o.paymentMethod && o.paymentMethod.includes("Chuyển khoản")) {
                orderBank += amt;
              } else if (o.paymentMethod && o.paymentMethod.includes("Thẻ tín dụng")) {
                orderCard += amt;
              } else {
                orderCOD += amt;
              }
            });

            // Cập nhật giao diện DOM với các số liệu mới
            function formatVNDLocal(num) {
              return num.toLocaleString('vi-VN') + 'đ';
            }

            document.getElementById('stat-revenue-real').textContent = formatVNDLocal(totalRevenue);
            document.getElementById('stat-count-completed').textContent = `✓ ${countCompleted} đơn hàng thành công`;
            
            document.getElementById('stat-revenue-pending').textContent = formatVNDLocal(pendingRevenue);
            document.getElementById('stat-count-pending-sum').textContent = `⏳ ${countPending + countProcessing + countShipping} đơn đang xử lý`;
            
            document.getElementById('stat-total-orders').textContent = filtered.length;
            document.getElementById('stat-count-cancelled').textContent = `✗ ${countCancelled} đơn đã hủy`;

            // Cập nhật phương thức thanh toán
            const totalPay = orderCOD + orderBank + orderCard;
            const codPct = totalPay > 0 ? (orderCOD / totalPay) * 100 : 0;
            const bankPct = totalPay > 0 ? (orderBank / totalPay) * 100 : 0;
            const cardPct = totalPay > 0 ? (orderCard / totalPay) * 100 : 0;

            document.getElementById('pay-cod-amount').textContent = formatVNDLocal(orderCOD);
            document.getElementById('pay-cod-progress').style.width = codPct + '%';

            document.getElementById('pay-bank-amount').textContent = formatVNDLocal(orderBank);
            document.getElementById('pay-bank-progress').style.width = bankPct + '%';

            document.getElementById('pay-card-amount').textContent = formatVNDLocal(orderCard);
            document.getElementById('pay-card-progress').style.width = cardPct + '%';

            // Cập nhật trạng thái
            document.getElementById('status-count-0').textContent = countPending;
            document.getElementById('status-count-1').textContent = countProcessing;
            document.getElementById('status-count-2').textContent = countShipping;
            document.getElementById('status-count-3').textContent = countCompleted;
          }
        </script>

        <!-- Tab Sản phẩm -->
        <div id="products-tab" class="tab-pane">
          <div class="card form-card">
            <h3>Thêm sản phẩm mới</h3>
            <form action="/add-product" method="POST" class="add-form">
              <input type="text" name="name" placeholder="Tên sản phẩm" required />
              <input type="text" name="price" placeholder="Giá" required />
              <select name="categoryId" required class="custom-select">
                <option value="" disabled selected>Chọn danh mục</option>
                <% categories.forEach(function(cat) { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
                <% }); %>
              </select>
              <input type="text" name="image" placeholder="URL Ảnh" />
              <input type="number" name="stock" placeholder="Số lượng kho" required min="0" />
              <div style="grid-column: span 3; display: flex; gap: 20px; align-items: center; margin-top: 10px; margin-bottom: 10px;">
                <label style="color: #fff; display: flex; align-items: center; gap: 8px;">
                  <input type="checkbox" name="isFlashSale" id="addFlashSaleCb" onchange="toggleFlashSaleFields('add')"> Flash Sale
                </label>
                <input type="number" name="discount" id="addDiscount" placeholder="% Giảm giá" min="0" max="100" style="display: none; width: 140px;" />
                <input type="number" name="soldProgress" id="addSold" placeholder="% Đã bán" min="0" max="100" style="display: none; width: 140px;" />
              </div>
              <div style="grid-column: span 3; display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <textarea name="description" placeholder="Mô tả sản phẩm" rows="3"></textarea>
                <textarea name="specifications" placeholder="Thông số kỹ thuật" rows="3"></textarea>
              </div>
              <button type="submit" class="primary-btn" style="grid-column: span 3">Thêm sản phẩm</button>
            </form>
          </div>

        <!-- Danh sách sản phẩm -->
        <div class="card list-card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="margin: 0;">Danh sách sản phẩm hệ thống</h3>
            <div style="position: relative;">
              <input 
                type="text" id="productSearchInput" onkeyup="searchProducts()"
                placeholder="Tìm tên sản phẩm..." 
                style="padding: 10px 15px 10px 40px; border-radius: 12px; border: 1px solid var(--admin-border); background: rgba(255,255,255,0.03); color: #fff; width: 280px; font-size: 13px;"
              >
              <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); opacity: 0.5;">🔍</span>
            </div>
          </div>
          <table class="product-table" id="productTable">
            <thead>
              <tr>
                <th>ID</th>
                <th>Ảnh</th>
                <th>Tên SP</th>
                <th>Giá</th>
                <th>Kho</th>
                <th>Danh mục</th>
                <th>Hành động</th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(function(product) { const category =
              categories.find(c => c.id === product.categoryId); %>
              <tr>
                <td><%= product.id %></td>
                <td>
                  <img
                    src="<%= product.image.startsWith('http') ? product.image : '/images/' + product.image + '.png' %>"
                    alt="img"
                    width="40"
                    height="40"
                    style="border-radius: 4px; object-fit: cover"
                    onerror="this.src = 'https://via.placeholder.com/40'"
                  />
                </td>
                <td><%= product.name %></td>
                <td><%= product.price %></td>
                <td>
                   <span class="badge" style="background: <%= (product.stock || 0) < 5 ? '#ff4d4d' : '#4CAF50' %>">
                      <%= product.stock || 0 %>
                   </span>
                </td>
                <td>
                  <span class="badge badge-category"
                    ><%= category ? category.name : 'Unknown' %></span
                  >
                </td>
                <td>
                  <div class="action-buttons">
                    <button
                      class="edit-btn"
                      data-id="<%= product.id %>"
                      data-name="<%= product.name %>"
                      data-price="<%= product.price %>"
                      data-category="<%= product.categoryId %>"
                      data-image="<%= product.image %>"
                      data-stock="<%= product.stock || 0 %>"
                      data-description="<%= product.description || '' %>"
                      data-specs="<%= product.specifications ? product.specifications.map(s => s.key + ': ' + s.value).join('\n') : '' %>"
                      data-isflashsale="<%= product.isFlashSale %>"
                      data-discount="<%= product.discount || 0 %>"
                      data-soldprogress="<%= product.soldProgress || 0 %>"
                      onclick="openEditFromButton(this)"
                    >
                      Sửa
                    </button>
                    <form
                      action="/delete-product/<%= product.id %>"
                      method="POST"
                      style="display: inline"
                    >
                      <button type="submit" class="danger-btn">Xóa</button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }); %> <% if(products.length === 0) { %>
              <tr>
                <td colspan="6" style="text-align: center">
                  Chưa có sản phẩm nào
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        </div> <!-- End Products Tab -->
  
        <!-- Tab Đơn hàng -->
        <div id="orders-tab" class="tab-pane">
          <div class="card list-card" style="padding: 0; overflow: hidden; background: transparent; border: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px 0;">
              <h3 style="margin: 0; font-size: 1.2rem; font-weight: 700;">Danh sách đơn hàng</h3>
              <div style="position: relative;">
                <input 
                  type="text" id="orderSearchInput" onkeyup="searchOrders()"
                  placeholder="Tìm kiếm mã đơn, tên..." 
                  style="padding: 8px 12px 8px 35px; border-radius: 8px; border: 1px solid var(--admin-border); background: var(--admin-card); color: #fff; width: 250px; font-size: 13px;"
                >
                <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); opacity: 0.5;">🔍</span>
              </div>
            </div>
            
            <div style="background: var(--admin-card); border-radius: 12px; border: 1px solid var(--admin-border); overflow: hidden;">
              <table class="order-table" id="orderTable">
                <thead>
                  <tr>
                    <th>MÃ ĐƠN</th>
                    <th>KHÁCH HÀNG</th>
                    <th>TỔNG TIỀN</th>
                    <th>TRẠNG THÁI</th>
                    <th>HÀNH ĐỘNG</th>
                  </tr>
                </thead>
                <tbody>
                  <% orders.forEach(function(order) { 
                    let statusClass = "pending";
                    let statusLabel = "Đã đặt";
                    if(order.status == -1) { statusClass = "cancel"; statusLabel = "Đã hủy"; }
                    else if(order.status == 1) { statusClass = "pending"; statusLabel = "Xử lý"; }
                    else if(order.status == 2) { statusClass = "shipping"; statusLabel = "Đang giao"; }
                    else if(order.status == 3) { statusClass = "done"; statusLabel = "Hoàn tất"; }
                  %>
                  <tr class="order-row" onclick="openOrderDetail(<%= JSON.stringify(order) %>)">
                    <td><span class="order-id-txt">#<%= order.id.slice(-8) %></span></td>
                    <td class="customer-name-cell"><div class="customer-name-txt"><%= order.customerName || 'Khách vãng lai' %></div></td>
                    <td><div class="total-amt-txt"><%= order.total %></div></td>
                    <td><span class="status-pill <%= statusClass %>"><%= statusLabel %></span></td>
                    <td onclick="event.stopPropagation()">
                      <form action="/update-order-status/<%= order.id %>" method="POST" style="margin:0">
                        <select name="status" onchange="this.form.submit()" class="custom-select" style="padding: 4px 8px; font-size: 11px; height: 32px; width: 110px;" <%= (order.status == -1 || order.status == 3) ? 'disabled' : '' %>>
                          <% if(order.status == -1) { %><option value="-1" selected>Đã hủy</option><% } %>
                          <option value="0" <%= order.status == 0 ? 'selected' : '' %>>Chờ xác nhận</option>
                          <option value="1" <%= order.status == 1 ? 'selected' : '' %>>Đang xử lý</option>
                          <option value="2" <%= order.status == 2 ? 'selected' : '' %>>Đang giao</option>
                          <option value="3" <%= order.status == 3 ? 'selected' : '' %>>Hoàn tất</option>
                        </select>
                      </form>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Tab Người dùng -->
        <div id="users-tab" class="tab-pane">
          <div class="card list-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
              <h3 style="margin: 0;">Danh sách người dùng hệ thống</h3>
              <div style="position: relative;">
                <input 
                  type="text" id="userSearchInput" onkeyup="searchUsers()"
                  placeholder="Tìm tên, email..." 
                  style="padding: 10px 15px 10px 40px; border-radius: 12px; border: 1px solid var(--admin-border); background: rgba(255,255,255,0.03); color: #fff; width: 280px; font-size: 13px;"
                >
                <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); opacity: 0.5;">🔍</span>
              </div>
            </div>
            <table class="product-table" id="userTable">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Họ và Tên</th>
                  <th>Email</th>
                  <th>Số điện thoại</th>
                  <th>Hành động</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(function(user) { %>
                <tr>
                  <td><%= user.id %></td>
                  <td><strong style="color: #fff;"><%= user.name %></strong></td>
                  <td><%= user.email %></td>
                  <td><span class="badge" style="background: rgba(99, 102, 241, 0.2); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.4);"><%= user.phone %></span></td>
                  <td>
                    <form
                      action="/delete-user/<%= user.id %>"
                      method="POST"
                      style="display: inline"
                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa người dùng này?')"
                    >
                      <button type="submit" class="danger-btn">Xóa</button>
                    </form>
                  </td>
                </tr>
                <% }); %> <% if(users.length === 0) { %>
                <tr>
                  <td colspan="5" style="text-align: center">
                    Chưa có người dùng nào đăng ký
                  </td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>

    <!-- Global Order Detail Modal -->
    <div id="orderModal" class="modal-overlay" onclick="closeOrderDetail()">
      <div class="modal-card" onclick="event.stopPropagation()">
        <div class="modal-header-box">
          <h3 id="modalOrderId" style="margin: 0; font-size: 16px; color: #fff;">Chi tiết đơn hàng</h3>
          <span style="cursor: pointer; font-size: 24px; color: var(--admin-text-muted)" onclick="closeOrderDetail()">&times;</span>
        </div>
        <div class="modal-body" id="modalContent"></div>
      </div>
    </div>

    <!-- Product Edit Modal -->
    <div id="editModal" class="modal-overlay" onclick="closeEditModal()">
      <div class="modal-card" onclick="event.stopPropagation()" style="max-width: 500px">
        <div class="modal-header-box">
          <h2 style="margin:0; font-size: 18px; color:#fff">Chỉnh sửa sản phẩm</h2>
          <span class="close" onclick="closeEditModal()">&times;</span>
        </div>
        <div class="modal-body">
          <form id="editForm" method="POST" class="add-form">
            <input type="text" id="editName" name="name" placeholder="Tên sản phẩm" required />
            <input type="text" id="editPrice" name="price" placeholder="Giá" required />
            <select id="editCategory" name="categoryId" required class="custom-select">
              <% categories.forEach(function(cat) { %>
              <option value="<%= cat.id %>"><%= cat.name %></option>
              <% }); %>
            </select>
            <input type="text" id="editImage" name="image" placeholder="URL Ảnh" />
            <input type="number" id="editStock" name="stock" placeholder="Số lượng kho" required min="0" />
            <div style="grid-column: span 2; display: flex; gap: 15px; align-items: center; margin-top: 10px; margin-bottom: 10px;">
              <label style="color: #fff; display: flex; align-items: center; gap: 8px;">
                <input type="checkbox" name="isFlashSale" id="editFlashSaleCb" onchange="toggleFlashSaleFields('edit')"> Flash Sale
              </label>
              <input type="number" name="discount" id="editDiscount" placeholder="% Giảm giá" min="0" max="100" style="display: none; width: 120px;" />
              <input type="number" name="soldProgress" id="editSold" placeholder="% Đã bán" min="0" max="100" style="display: none; width: 120px;" />
            </div>
            <textarea id="editDescription" name="description" placeholder="Mô tả sản phẩm" rows="2" class="custom-textarea" style="grid-column: span 2"></textarea>
            <textarea id="editSpecs" name="specifications" placeholder="Thông số kỹ thuật" rows="2" class="custom-textarea" style="grid-column: span 2"></textarea>
            <button type="submit" class="primary-btn-modern" style="grid-column: span 2; margin-top: 10px">Cập nhật sản phẩm</button>
          </form>
        </div>
      </div>
    </div>

    <script>
      function switchTab(tabId) {
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById(tabId + '-tab').classList.add('active');
        if(event) event.currentTarget.classList.add('active');
        
        const url = new URL(window.location);
        url.searchParams.set('tab', tabId);
        window.history.pushState({}, '', url);
      }

      function openOrderDetail(order) {
        const modal = document.getElementById('orderModal');
        const content = document.getElementById('modalContent');
        document.getElementById('modalOrderId').innerText = 'Chi tiết đơn hàng #' + order.id;
        
        const itemsHtml = order.items.map(item => `
          <div class="product-item-mini">
            <span>${item.name} <small style="color:#666; margin-left:8px">x${item.quantity}</small></span>
            <span style="font-weight:600; color:#fff">${item.price}</span>
          </div>
        `).join('');

        let reviewHtml = '';
        if (order.review) {
          const stars = '★'.repeat(order.review.rating) + '☆'.repeat(5 - order.review.rating);
          reviewHtml = `
            <div class="detail-section">
              <div class="detail-label">Đánh giá & Phản hồi</div>
              <div class="review-box-premium">
                <div style="color: #ffd700; margin-bottom: 5px; font-size: 14px;">${stars}</div>
                <div style="font-style: italic; color: #cbd5e1; margin-bottom: 12px; font-size: 13px;">"${order.review.comment}"</div>
                ${order.review.adminReply ? `
                  <div style="background: rgba(99, 102, 241, 0.05); padding: 12px; border-radius: 8px; border: 1px dashed rgba(99, 102, 241, 0.3);">
                    <div style="font-size: 10px; color: #6366f1; font-weight: 800; margin-bottom: 4px; letter-spacing: 1px;">PHẢN HỒI CỦA BẠN</div>
                    <div style="font-size: 13px; color: #fff;">${order.review.adminReply}</div>
                  </div>
                ` : `
                  <div class="reply-form-compact">
                    <input type="text" id="reply-input-${order.id}" placeholder="Nhập lời nhắn..." class="reply-input-modern">
                    <button onclick="submitReply('${order.id}')" class="primary-btn-modern">Gửi</button>
                  </div>
                `}
              </div>
            </div>
          `;
        }

        content.innerHTML = `
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
            <div>
              <div class="detail-label">Khách hàng</div>
              <div class="detail-content">
                <strong style="color:#fff; font-size:16px">${order.customerName || 'N/A'}</strong><br>
                <span style="color: #6366f1; font-weight:600">${order.customerPhone || 'N/A'}</span><br>
                <div style="margin-top:8px; font-size:12px; opacity:0.7">
                  PTTT: ${order.paymentMethod}<br>
                  Ngày đặt: ${new Date(order.orderDate).toLocaleString('vi-VN')}
                </div>
              </div>
            </div>
            <div>
              <div class="detail-label">Địa chỉ giao nhận</div>
              <div class="detail-content" style="font-size:13px">${order.address}</div>
            </div>
          </div>

          <div class="detail-section">
            <div class="detail-label">Danh sách sản phẩm</div>
            <div style="background: rgba(255,255,255,0.02); padding: 5px 16px; border-radius: 12px; border: 1px solid var(--admin-border);">
              ${itemsHtml}
              <div style="display: flex; justify-content: space-between; padding: 16px 0; border-top: 1px solid var(--admin-border); margin-top: 5px;">
                <span style="font-weight: 700; color:var(--admin-text-muted)">TỔNG CỘNG</span>
                <span style="font-weight: 800; color: #ff007f; font-size: 18px;">${order.total}</span>
              </div>
            </div>
          </div>
          ${reviewHtml}
        `;
        modal.style.display = 'flex';
      }

      function closeOrderDetail() { document.getElementById('orderModal').style.display = 'none'; }

      function searchOrders() {
        const filter = document.getElementById("orderSearchInput").value.toUpperCase();
        const rows = document.querySelectorAll("#orderTable .order-row");
        rows.forEach(row => {
          const text = row.innerText.toUpperCase();
          row.style.display = text.includes(filter) ? "" : "none";
        });
      }

      function searchProducts() {
        const filter = document.getElementById("productSearchInput").value.toUpperCase();
        const rows = document.querySelectorAll("#productTable tbody tr");
        rows.forEach(row => {
          const text = row.innerText.toUpperCase();
          row.style.display = text.includes(filter) ? "" : "none";
        });
      }

      function searchUsers() {
        const filter = document.getElementById("userSearchInput").value.toUpperCase();
        const rows = document.querySelectorAll("#userTable tbody tr");
        rows.forEach(row => {
          const text = row.innerText.toUpperCase();
          row.style.display = text.includes(filter) ? "" : "none";
        });
      }

      async function submitReply(orderId) {
        const reply = document.getElementById('reply-input-' + orderId).value.trim();
        if (!reply) return;
        try {
          const res = await fetch(`/api/orders/${orderId}/review/reply`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ adminReply: reply })
          });
          if (res.ok) location.reload();
          else alert('Lỗi khi gửi');
        } catch (e) { alert('Lỗi kết nối'); }
      }

      function openEditFromButton(btn) {
        document.getElementById('editForm').action = '/edit-product/' + btn.getAttribute('data-id');
        document.getElementById('editName').value = btn.getAttribute('data-name');
        document.getElementById('editPrice').value = btn.getAttribute('data-price');
        document.getElementById('editCategory').value = btn.getAttribute('data-category');
        document.getElementById('editImage').value = btn.getAttribute('data-image');
        document.getElementById('editStock').value = btn.getAttribute('data-stock');
        document.getElementById('editDescription').value = btn.getAttribute('data-description');
        document.getElementById('editSpecs').value = btn.getAttribute('data-specs');
        
        const isFlashSale = btn.getAttribute('data-isflashsale') === 'true';
        document.getElementById('editFlashSaleCb').checked = isFlashSale;
        document.getElementById('editDiscount').value = btn.getAttribute('data-discount') || 0;
        document.getElementById('editSold').value = btn.getAttribute('data-soldprogress') || 0;
        toggleFlashSaleFields('edit');
        
        document.getElementById('editModal').style.display = 'flex';
      }

      function closeEditModal() { document.getElementById('editModal').style.display = 'none'; }

      function toggleFlashSaleFields(prefix) {
        const isChecked = document.getElementById(prefix + 'FlashSaleCb').checked;
        document.getElementById(prefix + 'Discount').style.display = isChecked ? 'block' : 'none';
        document.getElementById(prefix + 'Sold').style.display = isChecked ? 'block' : 'none';
      }

      window.onload = function() {
        const tab = new URLSearchParams(window.location.search).get('tab');
        if (tab === 'products') {
          const btn = document.querySelectorAll('.tab-btn')[1];
          if(btn) btn.click();
        } else if (tab === 'orders') {
          const btn = document.querySelectorAll('.tab-btn')[2];
          if(btn) btn.click();
        } else if (tab === 'users') {
          const btn = document.querySelectorAll('.tab-btn')[3];
          if(btn) btn.click();
        }
      }
      
      window.onclick = function (event) {
        if (event.target.classList.contains("modal-overlay")) {
          closeOrderDetail();
          closeEditModal();
        }
      };
    </script>
  </body>
</html>
